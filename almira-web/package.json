{
  "name": "almira-web",
  "private": true,
  "version": "0.1.0",
  "description": "A responsive, unisex wardrobe companion with user-controlled style preferences.",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check:types": "tsc --noEmit",
    "check:backend": "tsc --noEmit -p tsconfig.backend.json",
    "check": "pnpm test && pnpm check:types && pnpm check:backend"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "lucide-react": "1.49.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
